# Server Port
PORT=5077
HOST=0.0.0.0
NODE_ENV=production

# PostgreSQL Database Connection
# Option 1: Direct Connection URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hrsdgdg_db

# Option 2: Individual Connection Parameters
PGHOST=localhost
